#!/usr/bin/env bash
#
# Run a command with the "shell-env" Bitwarden credentials exported.
#
# Exists because the morning-briefing skill runs as many separate shells (every
# Claude Code tool call is a fresh process), so `source ~/.zshrc` cannot help:
# bw-env.zsh only *defines* bwload, and a bwload run in another terminal does
# not propagate here. Wrapping each command re-exports the vars per process.
#
# Secrets are exported into the child process only. They are never written to
# disk, never logged, and never echoed — diagnostics name variables, never
# values. The only thing persisted is the Bitwarden session token, cached mode
# 600, shared with swat-dash so one unlock serves both.
#
# Usage:
#   briefing-env curl -s -u "$JIRA_EMAIL:$JIRA_API_TOKEN" ...
#   briefing-env python3 ~/Scripts/jira-stalker.py --prio high --days 1
#   briefing-env --check              # report which vars are present, run nothing
#   briefing-env --unlock             # prompt for master password, cache session
#   briefing-env --relock             # drop the cached session
#
# Note the quoting: in `briefing-env curl -u "$JIRA_EMAIL:..."` the outer shell
# expands $JIRA_EMAIL *before* this script runs, so it comes out empty. Use
# single quotes and let the child expand it, or better, pass creds via a form
# that defers expansion:
#   briefing-env sh -c 'curl -s -u "$JIRA_EMAIL:$JIRA_API_TOKEN" ...'
#
set -euo pipefail

BW_ITEM="${SWAT_BW_ITEM:-shell-env}"
CACHE="${BW_SESSION_CACHE:-$HOME/.config/swat-dash/bw-session}"
CACHE_DIR="$(dirname "$CACHE")"

# Checked for presence after export. Everything else in the note is exported
# too; these are just the ones the briefing and the SWAT skills actually need.
# Only JIRA_* is required — the rest are per-skill, and a missing one should
# disable that skill, not fail every command.
REQUIRED=(JIRA_EMAIL JIRA_API_TOKEN)
OPTIONAL=(
  ZULIP_EMAIL ZULIP_API_KEY ZULIP_SITE   # zulip, morning-briefing
  EEN_USERNAME EEN_PASSWORD              # support-tool, getlogs (V1 auth, needs VPN)
)
# Zoho is deliberately not configured (decided 2026-09-21). The zoho-desk skill
# treats its OAuth triple as break-glass anyway — the supported path is the
# zoho-mcp MCP server, which holds no local token and cannot trip Zoho's
# refresh-endpoint lockout. If Zoho work ever becomes necessary, get zoho-mcp
# provisioned rather than minting a Self Client here, and add the PreToolUse
# write guard that zoho-desk/SKILL.md assumes exists first.
# EEN_CLI is a path to the CLI binary, not a secret; set it once the binary
# exists locally.

die()  { printf '  briefing-env error: %s\n' "$1" >&2; exit 1; }
note() { printf '  briefing-env: %s\n' "$1" >&2; }

mode="run"
case "${1:-}" in
  --check)  mode="check";  shift ;;
  --unlock) mode="unlock"; shift ;;
  --relock)
    rm -f "$CACHE"
    bw lock >/dev/null 2>&1 || true
    note "cleared cached session"
    exit 0
    ;;
esac

[[ "$mode" != "run" || $# -gt 0 ]] || die "no command given (see --check, --unlock)"

command -v bw >/dev/null 2>&1 || die "bw CLI not found (brew install bitwarden-cli)"
command -v jq >/dev/null 2>&1 || die "jq not found (brew install jq)"

# ---------------------------------------------------------------- session ----

session_ok() {
  local s="${1:-}"
  [[ -n "$s" ]] || return 1
  if bw unlock --check --session "$s" >/dev/null 2>&1; then return 0; fi
  [[ "$(bw status --session "$s" 2>/dev/null | jq -r '.status // empty')" == "unlocked" ]]
}

mkdir -p "$CACHE_DIR"
chmod 700 "$CACHE_DIR"

session=""
if [[ -f "$CACHE" ]]; then
  session="$(cat "$CACHE" 2>/dev/null || true)"
  session_ok "$session" || { session=""; note "cached session expired"; }
fi

if [[ -z "$session" ]]; then
  # Never block on a password prompt with no tty to answer it — an automated
  # caller (Claude Code's Bash) would just hang. Fail with the fix instead.
  if [[ "$mode" != "unlock" && ! -t 0 ]]; then
    die "vault is locked and there is no terminal to prompt on.
         Run this once in your own terminal, then retry:  briefing-env --unlock"
  fi
  note "unlocking Bitwarden vault (master password prompt follows)"
  # Prompts on the tty. bw itself reads the password; this script never sees,
  # stores, or forwards it.
  session="$(bw unlock --raw)" || die "unlock failed"
  [[ -n "$session" ]] || die "unlock returned an empty session"
  ( umask 077; printf '%s' "$session" >"$CACHE" )
  chmod 600 "$CACHE"
  note "session cached to $CACHE (mode 600)"
fi

export BW_SESSION="$session"

# Without a sync the CLI serves a stale local cache, which silently yields old
# credentials (a stale JIRA token shows up as empty results, not an auth error).
# Non-fatal: offline, the cached vault is still worth trying.
if bw sync --session "$session" >/dev/null 2>&1; then
  :
else
  note "warning: sync failed — using locally cached vault (values may be stale)"
fi

# ------------------------------------------------------------------ fetch ----

item_json="$(bw get item "$BW_ITEM" --session "$session" 2>/dev/null)" \
  || die "could not read Bitwarden item '$BW_ITEM' (check the name, or run: bw sync)"

# Note body first, then custom fields, so a custom field wins over a same-named
# line in the body.
env_lines="$(
  printf '%s' "$item_json" | jq -r '
    (((.notes // "") | split("\n")) | map(
        gsub("^\\s*export\\s+"; "")
        | select(test("^\\s*[A-Za-z_][A-Za-z0-9_]*\\s*="))
      ))
    + ((.fields // []) | map(
        select((.name // "") != "" and (.value // "") != "")
        | "\(.name)=\(.value)"
      ))
    | .[]'
)"

count=0
while IFS= read -r line; do
  [[ -n "$line" ]] || continue
  key="${line%%=*}"
  val="${line#*=}"
  key="${key//[[:space:]]/}"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  case "$val" in
    \"*\") val="${val#\"}"; val="${val%\"}" ;;
    \'*\') val="${val#\'}"; val="${val%\'}" ;;
  esac
  export "$key=$val"
  count=$((count + 1))
done <<<"$env_lines"

[[ "$count" -gt 0 ]] || die "no KEY=VALUE pairs found in item '$BW_ITEM'"

# ----------------------------------------------------------------- verify ----

missing=()
for v in "${REQUIRED[@]}"; do
  [[ -n "${!v:-}" ]] || missing+=("$v")
done

if [[ "$mode" == "check" ]]; then
  note "exported $count vars from '$BW_ITEM'"
  for v in "${REQUIRED[@]}" "${OPTIONAL[@]}"; do
    if [[ -n "${!v:-}" ]]; then printf '  SET      %s\n' "$v" >&2
    else                        printf '  NOT SET  %s\n' "$v" >&2; fi
  done
  ((${#missing[@]} == 0)) || die "missing required: ${missing[*]}"
  note "ready"
  exit 0
fi

if [[ "$mode" == "unlock" ]]; then
  note "vault unlocked, session cached, $count vars readable"
  exit 0
fi

((${#missing[@]} == 0)) || die "missing required vars in '$BW_ITEM': ${missing[*]}"

# ------------------------------------------------------------------- exec ----

exec "$@"
